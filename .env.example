# ─────────────────────────────────────────────────────────────────────────────
# OpenFraudMonitoring — Build & Runtime Configuration
# Copy this file to .env and adjust values for your environment.
# docker-compose reads this file automatically.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=ofm
POSTGRES_PASSWORD=ofm
POSTGRES_DB=ofm
DATABASE_URL=postgresql://ofm:ofm@db:5432/ofm

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=ofm
RABBITMQ_PASSWORD=ofm
RABBITMQ_URL=amqp://ofm:ofm@rabbitmq:5672/

# ── Backend server ────────────────────────────────────────────────────────────
# production (default) rejects weak secrets at startup; development skips those checks.
OFM_ENV=production
FLASK_DEBUG=0
PORT=5000
LOG_LEVEL=DEBUG
OFM_SAVE_PRIVATE_IP=True # enable logging sessions from private IPs here
# SQLAlchemy pool sizing.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Authentication / RBAC ────────────────────────────────────────────────────
# Secret used to sign JWT tokens. MUST be changed in production.
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=24
# Default admin account created on first boot.
OFM_ADMIN_USERNAME=admin
OFM_ADMIN_PASSWORD=admin
# Bootstrap API token for the admin account.
# Connectors use this token to self-register on first start.
OFM_ADMIN_TOKEN=dev-admin-token

# ── Intelligence ──────────────────────────────────────────────────────────────
INTEL_DECAY_DAYS=7

# ── Worker ────────────────────────────────────────────────────────────────────
PERIODIC_INTERVAL_SECONDS=60

# ── Device matching ──────────────────────────────────────────────────────────
# Minimum weighted score (0-1) to link a fingerprint to an existing device.
DEVICE_MATCH_THRESHOLD=0.75

# ── Build / Debug ────────────────────────────────────────────────────────────
OFM_DEBUG=true

# ── Client (ofm.js) ──────────────────────────────────────────────────
# The URL the ofm.js client sends data to.
# Leave empty for same-origin (client served from same domain as backend).
# Set to a full URL (e.g. https://ofm.example.com) for cross-origin collection.
# Cookie-based authentication detection requires same-origin collection —
# see docs/deployment.md.
OFM_SERVER_URL=
# XOR key used to encrypt the fingerprint payload. Used at client build time
# AND by the backend to decrypt — changing it requires rebuilding backend and
# frontend together (docker compose build backend frontend).
FPSCANNER_KEY=dev-key
# Capture the actual copied/pasted clipboard text in behavioral events.
# Off by default for privacy. Set to "true" to include the content (a global
# GUI setting can censor it to first/last character in the session view).
OFM_CAPTURE_CLIPBOARD=false

# ── Connectors ───────────────────────────────────────────────────────────────
BACKEND_URL=http://backend:5000
